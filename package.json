    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cheerio": "^1.0.0",
    "sharp": "^0.34.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "allowScripts": {
